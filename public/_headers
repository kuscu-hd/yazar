# =====================================================================
# KOPFZEILEN.  Netlify wendet jede passende Regel an; eine genauere Regel
# hebt "/*" nicht auf, sie kommt hinzu. Diese Datei muss im
# veröffentlichten Verzeichnis liegen, sonst greift keine Regel.
# =====================================================================

# Die sitemap wird sonst je nach Erkennung als text/plain ausgeliefert.
/sitemap.xml
  Content-Type: application/xml; charset=utf-8

# Für die ganze Seite. Noch keine CSP -- die kommt erst, wenn feststeht,
# was von außen geladen werden darf.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Videos, Aufnahmen und das Logo ändern sich nie. Netlify liefert sonst
# alles mit "max-age=0, must-revalidate" aus: der Browser fragt dann bei
# jedem Wiedersehen für jede Datei nach -- elf Nachfragen allein für die
# Startseite, auf dem Mobilfunknetz je ein Zehntel bis drittel Sekunde.
# Mit einem Jahr und "immutable" fragt er gar nicht mehr.
#
# ACHTUNG, das ist der Preis: eine geänderte Datei unter /assets/ erreicht
# wiederkehrende Besucher bis zu ein Jahr lang nicht. Wer dort etwas
# austauscht, gibt der Datei einen neuen Namen.
#
# styles.css und script.js bleiben bewusst draußen: sie ändern sich oft,
# tragen keine Versionsnummer im Namen und sind komprimiert nur 20 und
# 17 KB -- die Nachfrage kostet dort weniger als ein veralteter Stand.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
